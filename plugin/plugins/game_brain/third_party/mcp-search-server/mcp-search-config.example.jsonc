{
  // ===========================================================
  // mcp-search-server 用户配置文件 (JSONC)
  // 放置项目根目录，命名 mcp-search-config.json 或 .jsonc
  // 环境变量：SEARCH_CONFIG_PATH=/path/to/config.json
  // ===========================================================

  // 自定义搜索引擎（可添加任意 HTML 抓取引擎）
  "customEngines": [
    // {
    //   "name": "mysearch",
    //   "displayName": "MySearch",
    //   "searchUrl": "https://mysearch.example.com/search?q={query}&page={page}",
    //   "selectors": {
    //     "item": ".result-item",
    //     "title": "h2 a",
    //     "url": "h2 a@href",
    //     "description": ".desc"
    //   },
    //   "headers": { "Referer": "https://mysearch.example.com/" },
    //   "pageParam": "page",
    //   "startPage": 1
    // }
  ],

  // 请求频率限制（按域名，毫秒）
  "rateLimits": {
    "baidu.com": { "minDelay": 1000, "maxDelay": 3000 },
    "so.com":   { "minDelay": 800,  "maxDelay": 2000 },
    "sogou.com": { "minDelay": 1500, "maxDelay": 4000 }
  },

  // 额外请求头（按域名）
  "extraHeaders": {
    "baidu.com": {
      "Referer": "https://www.baidu.com/",
      "Connection": "keep-alive"
    },
    "so.com": {
      "Referer": "https://www.so.com/"
    }
  }
}
